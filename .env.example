# ==============================================================================
# EPC Competitor Intelligence Agent — Environment Configuration Template
# Copy this file to .env and fill in your active credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq LLM API Configuration
# Get a free API key at: https://console.groq.com/keys
# Default model: llama-3.3-70b-versatile
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# 1. Create a bot using @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your chat ID (or group/channel ID) using @userinfobot or Telegram API
# Multiple chat IDs can be comma-separated: 123456789,-100987654321
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# Pipeline & Monitoring Settings
# ------------------------------------------------------------------------------
# Comma-separated list of tracked companies (leave empty to use default 15 EPC peers)
# TRACKED_COMPANIES=Saipem,Fluor,Bechtel,Worley,Petrofac,McDermott,Wood Group,MAIRE,JGC Holdings,Larsen & Toubro,Samsung E&A,AECOM,Baker Hughes,Linde,AtkinsRealis

# Pipeline thresholds
MAX_ARTICLES_PER_FEED=50
DIGEST_MAX_ARTICLES=10
BREAKING_NEWS_THRESHOLD=8.5
SUMMARY_LANGUAGE=english
LOG_LEVEL=INFO

# Groq Rate Limiting (tuned for free tier ~5 RPM)
GROQ_BATCH_SIZE=10
GROQ_RETRY_ATTEMPTS=3
GROQ_RETRY_BASE_DELAY=12.0
GROQ_COOLDOWN_DELAY=12.0
